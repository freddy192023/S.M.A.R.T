{
  "rewrites": [
    { "source": "/api/events/reserva", "destination": "/api/reserva" },
    { "source": "/api/events/cancelacion", "destination": "/api/reserva" },
    { "source": "/api/events/viaje", "destination": "/api/reserva" },
    { "source": "/api/events/log", "destination": "/api/reserva" },
    { "source": "/api/reservations/confirmar", "destination": "/api/confirmar" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
